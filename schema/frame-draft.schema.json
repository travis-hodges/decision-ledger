{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision Ledger intake draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question",
    "objective",
    "options",
    "constraints",
    "suggestedCriteria",
    "openQuestions"
  ],
  "properties": {
    "question": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "excerpt"],
        "properties": {
          "name": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "excerpt"],
        "properties": {
          "statement": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          }
        }
      }
    },
    "suggestedCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "why"],
        "properties": {
          "name": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
